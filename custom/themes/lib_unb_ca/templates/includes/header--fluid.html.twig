{{ attach_library('alert_scheduler_client/alerts') }}
<div id="emergency-banner">
    <div class="container" data-alerts-container></div>
</div>

<div id="header-overlay">
    <div id="navbar-top">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex branding">
                <a href="https://lib.unb.ca">
                    {% include '@unb_lib_theme/includes/unb-lib-logo.html.twig' %}
                </a>
            </div>
            <nav aria-label="Header Utility Menu" class="d-none d-md-block text-right">
                <ul id="menu-secondary" class="list-inline mb-1">
                    <li class="list-inline-item">
                        <a href="https://lib.unb.ca/search">Search this Site</a>
                    </li>
                    <li class="list-inline-item">
                        <a href="https://lib.unb.ca/about/find-us">Floor Plans</a>
                    </li>
                    <li class="list-inline-item">
                        <a href="https://unb.ca">UNB<i class="fa-solid fs-xs fa-up-right-from-square ml-1 ms-1" aria-hidden="true"></i></a>
                    </li>
                </ul>
                <ul id="header-buttons" class="list-inline mb-0">
                    <li class="list-inline-item">
                        <a class="btn btn-sm btn-light border-dark"><i class="fa-solid fa-user mr-1 me-1" aria-hidden="true"></i>My Account</a>
                    </li>
                    <li class="list-inline-item">
                        <a class="btn btn-sm btn-dark"><i class="fa-solid fa-house-circle-check mr-1 me-1" aria-hidden="true"></i>Book Study Space</a>
                    </li>
                    <li class="list-inline-item">
                        <a class="btn btn-sm btn-warning"><i class="fa-solid fa-comments mr-1 me-1" aria-hidden="true"></i>Ask Us</a>
                    </li>
                </ul>
                {% if show_top_header_login or show_top_header_logout %}
                    <ul class="d-none nav ml-auto">
                        {% if logged_in and show_top_header_logout %}
                            <li>{{ logout_link }}</li>
                        {% elseif not logged_in and show_top_header_login %}
                            <li>{{ login_link }}</li>
                        {% endif %}
                    </ul>
                {% endif %}
            </nav>
        </div>
    </div>
    <nav aria-label="Main Menu" id="navbar-main" class="navbar navbar-expand-lg px-0">
        <div class="w-100">
            <div id="navbar-main-content" class="d-flex align-items-stretch flex-column flex-lg-row w-100">
                <div id="nav-btn" class="d-flex d-lg-none py-2">
                    <ul class="container nav nav-pills">
                        <li class="nav-item flex-fill text-center">
                            <button id="btn-menu" class="btn btn-{{ nav_btn_style }}" type="button" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar" aria-label="Toggle navigation">Menu</button>
                        </li>
                        <li class="nav-item flex-fill text-center">
                            {% if (nav_btn_hours_toggle == true) %}
                                <button id="btn-hours" class="btn btn-{{ nav_btn_style }}" aria-controls="banner" aria-expanded="false" data-target="#banner" data-toggle="collapse" aria-label="Toggle Hours">Hours <span class="fas fa-clock"></span></button>
                            {% else %}
                                <a id="btn-hours" class="btn btn-{{ nav_btn_style }}" href="/about/hours">Hours <span class="fas fa-clock"></span></a>
                            {% endif %}
                        </li>
                        <li class="nav-item flex-fill text-center">
                            <a id="btn-askus" class="btn btn-{{ nav_btn_style }}" href="/help/ask-us">AskUs <span class="fas fa-comments"></span></a>
                        </li>
                    </ul>
                </div>
                {% include '@unb_lib_theme/includes/megamenu.html.twig' %}
            </div>
        </div>
    </nav>
</div>
